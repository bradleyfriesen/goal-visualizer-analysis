import sportypy
print(sportypy.__version__)


from importlib.metadata import version

print(version("sportypy"))


import inspect
print(inspect.getsource(NHLRink.draw))


from sportypy._feature_classes import hockey as hockey_features


from time import perf_counter

rink = NHLRink()
fig, ax = plt.subplots(figsize=(12, 6))

ax.set_aspect("equal")
ax.axis("off")

transform = rink._get_transform(ax)
constraint = rink._add_surface_constraint(ax, transform)

for i, feature in enumerate(rink._features):
    t0 = perf_counter()
    drawn_feature = feature.draw(ax, transform)
    draw_time = perf_counter() - t0

    if feature.is_constrained:
        drawn_feature.set_clip_path(constraint)

    translate_time = 0
    if feature.visible and not isinstance(feature, hockey_features.Boards):
        t0 = perf_counter()
        feature._translate_feature()
        translate_time = perf_counter() - t0

    print(
        f"{i:2d} {type(feature).__name__:25s} "
        f"draw={draw_time:.3f}s  translate={translate_time:.3f}s"
    )


fig, ax = plt.subplots(
    figsize=(12, 6),
    constrained_layout=False
)

rink = NHLRink()
rink.draw(ax=ax)
plt.show()


